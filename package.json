{
  "name": "@oval-vote/brand",
  "version": "0.1.0",
  "description": "The Oval design system: tokens, components, logo, and wordmark",
  "license": "MIT AND CC-BY-ND-4.0",
  "exports": {
    "./tokens/oval.css": "./tokens/oval.css",
    "./tokens/oval.json": "./tokens/oval.json",
    "./css/components.css": "./css/components.css",
    "./logo/*": "./logo/*"
  },
  "files": [
    "tokens/",
    "css/",
    "logo/"
  ],
  "scripts": {
    "logo": "node scripts/logo.mjs",
    "logo:check": "node scripts/logo.mjs --check",
    "avatar": "node scripts/avatar.mjs",
    "avatar:check": "node scripts/avatar.mjs --check",
    "build": "rm -rf dist && mkdir dist && cp -R index.html logo tokens css dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run logo:check && npm run avatar:check",
    "test": "npm run check"
  },
  "repository": "github:oval-vote/brand",
  "homepage": "https://brand.oval.vote",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "2.0.4",
    "prettier": "3.9.10"
  }
}
